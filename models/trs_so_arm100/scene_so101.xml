<mujoco model="so101 cube scene">
  <!-- Task 4: synthetic data scene. SO-101 (SO-ARM100 geometry) + a 50 mm orange cube,
       viewed from the wrist-mounted camera defined in so_arm100.xml. Lives in this folder
       so the arm's meshdir="assets/" resolves. The cube is a primitive box (no mesh) and
       matches a solid 50 mm PLA print. -->
  <include file="so_arm100.xml"/>

  <statistic center="0.1 -0.1 0.05" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- Wood table surface (type=2d for a flat plane; tiled across the floor). -->
    <texture type="2d" name="wood_tex" file="wood.png"/>
    <material name="wood_mat" texture="wood_tex" texuniform="true" texrepeat="2 2"
      specular="0.4" shininess="0.1"/>
    <!-- Orange PLA. The generator jitters this rgba for domain randomization. -->
    <material name="cube_mat" rgba="1 0.45 0.05 1" specular="0.3" shininess="0.25"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="wood_mat"/>

    <!-- 50 mm cube (box size is half-extent -> 0.025). Resting on the floor at z=0.025.
         freejoint lets the generator set an arbitrary pose per frame; we render with
         mj_forward so it stays where placed instead of falling. -->
    <body name="cube" pos="0.15 -0.18 0.025">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" material="cube_mat" mass="0.05"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- "look" = validated pose where the wrist cam looks down at the table and the cube
         sits in frame (with the gripper finger as a realistic occluder). First 6 = arm
         joints (last is Jaw); then cube freejoint qpos (x y z + quat). The generator starts
         from this pose and randomizes around it. -->
    <key name="look"
         qpos="-1.2571 -2.1971 1.5578 1.6597 1.2158 0  -0.2 -0.132 0.025 1 0 0 0"
         ctrl="-1.2571 -2.1971 1.5578 1.6597 1.2158 0"/>
  </keyframe>
</mujoco>
